# Server Configuration
PORT=5000

# Database Configuration (SQLite dev.db or PostgreSQL/MySQL connection string)
DATABASE_URL="file:./dev.db"

# Security Secrets (IMPORTANT: Keep secret and change in production!)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_in_production"

# Payment Gateway Configuration (Razorpay / Stripe)
RAZORPAY_KEY_ID="rzp_test_mockkey123"
RAZORPAY_KEY_SECRET="mock_razorpay_secret_456"

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"

# Frontend Application URL
FRONTEND_URL="http://localhost:5173"
