# Application Environment & Security Controls (Debug Mode OFF in Production)
NODE_ENV="production"
DEBUG="false"

# Server Configuration
PORT=5000

# Database Configuration (SQLite dev.db or PostgreSQL/MySQL connection string)
DATABASE_URL="file:./dev.db"

# Security Secrets (IMPORTANT: Keep secret and change in production!)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_in_production"

# Seed User Passwords (Optional, for database seeding)
SEED_ADMIN_PASSWORD="change_admin_password_on_seed"
SEED_USER_PASSWORD="change_user_password_on_seed"

# Payment Gateway Configuration (Razorpay / Stripe)
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"

# Frontend Application URL
FRONTEND_URL="http://localhost:5173"
