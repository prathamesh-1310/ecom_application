generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String
  name              String
  phone             String?
  role              String            @default("RETAIL_CUSTOMER") // SUPER_ADMIN, STAFF_ADMIN, RETAIL_CUSTOMER, B2B_CUSTOMER
  b2bApprovalStatus String?           // PENDING, APPROVED, REJECTED, SUSPENDED
  companyName       String?
  gstNumber         String?
  businessType      String?
  expectedVolume    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  addresses         Address[]
  carts             Cart[]
  wishlists         Wishlist[]
  orders            Order[]
  reviews           Review[]
  supportRequests   SupportRequest[]
  b2bApplications   B2BApplication[]
  policyAcceptances PolicyAcceptance[]
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  addressType  String   @default("Home") // Home, Office, Other
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String   @default("India")
  postalCode   String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  image       String?
  status      String        @default("ACTIVE")
  createdAt   DateTime      @default(now())

  subcategories Subcategory[]
  products      Product[]
}

model Subcategory {
  id          String    @id @default(uuid())
  categoryId  String
  name        String
  slug        String    @unique
  description String?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]
}

model Product {
  id                       String               @id @default(uuid())
  categoryId               String
  subcategoryId            String?
  name                     String
  slug                     String               @unique
  sku                      String               @unique
  description              String
  retailPrice              Float
  salePrice                Float?
  b2bPrice                 Float?
  stock                    Int                  @default(0)
  moq                      Int                  @default(1)
  visibility               String               @default("BOTH") // RETAIL, B2B, BOTH
  returnable               Boolean              @default(false)  // Strict No Return default
  refundable               Boolean              @default(false)  // Strict No Refund default
  exceptionalReviewEnabled Boolean              @default(true)
  careInstructions         String?
  hygieneNotice            String?
  status                   String               @default("ACTIVE")
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  category Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id])
  variants ProductVariant[]
  images ProductImage[]
  pricingRules ProductPricingRule[]
  cartItems CartItem[]
  wishlistItems WishlistItem[]
  orderItems OrderItem[]
  reviews Review[]
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  name            String   // e.g. Size, Material, Color
  value           String   // e.g. 16G, Titanium, Gold
  priceAdjustment Float    @default(0.0)
  stock           Int      @default(0)
  sku             String   @unique
  returnable      Boolean  @default(false)
  refundable      Boolean  @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  wishlistItems WishlistItem[]
  orderItems OrderItem[]
}

model ProductImage {
  id           String  @id @default(uuid())
  productId    String
  imageUrl     String
  displayOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductPricingRule {
  id                 String  @id @default(uuid())
  productId          String
  customerType       String  @default("B2B")
  minimumQuantity    Int     @default(1)
  price              Float
  discountPercentage Float?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String   @id @default(uuid())
  userId    String?
  sessionId String?
  platform  String   @default("RETAIL") // RETAIL, B2B
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  unitPrice Float

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  productId  String
  variantId  String?
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])
}

model Order {
  id                  String   @id @default(uuid())
  userId              String?
  platform            String   @default("RETAIL") // RETAIL, B2B
  orderNumber         String   @unique
  subtotal            Float
  discount            Float    @default(0.0)
  shippingCharge      Float    @default(0.0)
  tax                 Float    @default(0.0)
  totalAmount         Float
  paymentStatus       String   @default("Pending") // Pending, Authorized, Paid, Failed, Refunded, Refund Exception Approved
  orderStatus         String   @default("Pending") // Pending, Confirmed, Processing, Packed, Shipped, In Transit, Delivered, Cancelled
  shippingStatus      String   @default("Not Shipped") // Not Shipped, Processing, Packed, Shipped, In Transit, Out for Delivery, Delivered
  shippingAddressJson String
  billingAddressJson  String?
  trackingNumber      String?
  policyVersion       String   @default("1.0")
  policyAccepted      Boolean  @default(true)
  policyAcceptedAt    DateTime @default(now())
  policyAcceptedIp    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])
  items OrderItem[]
  payments Payment[]
  supportRequests SupportRequest[]
  policyAcceptances PolicyAcceptance[]
}

model OrderItem {
  id          String @id @default(uuid())
  orderId     String
  productId   String
  variantId   String?
  productName String
  sku         String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String
  gateway       String   @default("Razorpay")
  transactionId String?
  amount        Float
  status        String   @default("Created") // Created, Authorized, Captured, Failed, Refunded
  paymentMethod String?
  responseData  String?
  createdAt     DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Coupon {
  id                String    @id @default(uuid())
  code              String    @unique
  discountType      String    @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue     Float
  minimumOrderValue Float     @default(0.0)
  maximumDiscount   Float?
  usageLimit        Int?
  usedCount         Int       @default(0)
  startDate         DateTime?
  endDate           DateTime?
  platform          String    @default("ALL") // RETAIL, B2B, ALL
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  orderId   String?
  rating    Int
  comment   String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model SupportRequest {
  id                 String    @id @default(uuid())
  orderId            String
  userId             String
  requestType        String    @default("EXCEPTIONAL_ISSUE") // DEFECTIVE, DAMAGED, WRONG_ITEM, LOST_IN_TRANSIT
  reason             String
  description        String
  attachmentUrls     String?   // JSON array of image URLs
  status             String    @default("Submitted") // Submitted, Under Review, Additional Info Required, Approved Exceptional Case, Rejected Under Policy, Replacement Approved, Store Credit Approved, Refund Approved, Resolved, Closed
  approvedRemedy     String?   // Replacement, Store Credit, Manual Refund Exception
  refundAmount       Float?
  storeCreditAmount  Float?
  adminNotes         String?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model PolicyVersion {
  id            String   @id @default(uuid())
  platform      String   @default("ALL") // RETAIL, B2B, ALL
  policyName    String   @default("No Return and No Refund Policy")
  version       String   @default("1.0")
  content       String
  effectiveDate DateTime @default(now())
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())

  acceptances PolicyAcceptance[]
}

model PolicyAcceptance {
  id              String   @id @default(uuid())
  orderId         String
  userId          String?
  policyVersionId String?
  acceptedAt      DateTime @default(now())
  ipAddress       String?
  userAgent       String?

  order Order @relation(fields: [orderId], references: [id])
  user User? @relation(fields: [userId], references: [id])
  policyVersion PolicyVersion? @relation(fields: [policyVersionId], references: [id])
}

model Banner {
  id           String    @id @default(uuid())
  platform     String    @default("RETAIL") // RETAIL, B2B
  title        String
  subtitle     String?
  image        String
  link         String?
  displayOrder Int       @default(0)
  startDate    DateTime?
  endDate      DateTime?
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
}

model B2BApplication {
  id             String    @id @default(uuid())
  userId         String
  companyName    String
  gstNumber      String?
  businessType   String
  expectedVolume String?
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED
  adminNotes     String?
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
